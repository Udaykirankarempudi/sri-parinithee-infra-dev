# Sri Parinithee Infra Developers - Environment Variables Template
# Copy this file to .env or .env.local to customize for local development

# Application base URL
VITE_SITE_URL=http://localhost:5173

# Optional: Form submission API / CRM webhook endpoint
# If not configured, enquiries operate in client-side interactive simulated mode
# VITE_CONTACT_API_URL=https://api.sriparinitheeinfra.com/v1/enquiries

# Optional: Google Maps Embed / JavaScript API Key
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

